# ============================================================
# 后台管理系统 - Nginx 配置示例
# 位置: /etc/nginx/conf.d/admin-system.conf (Linux)
# 使用前请替换 server_name 与 root 路径
# ============================================================

server {
    listen 80;
    # 改成你的域名或服务器 IP
    server_name your-domain.com;

    # 前端构建产物目录(frontend/dist 上传到服务器后的路径)
    root /var/www/admin-system/frontend/dist;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1k;

    # SPA history 路由:找不到对应文件时回退到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 静态资源(带 hash 的构建产物)长缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 后端 API 反向代理
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 流式/大响应超时(导出 Excel、流式输出等)
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # 后端接口文档
    location /docs {
        proxy_pass http://127.0.0.1:8000/docs;
        proxy_set_header Host $host;
    }
}

# ============================================================
# HTTPS(certbot 自动生成,参考:
#   sudo certbot --nginx -d your-domain.com
# ============================================================
